<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> | StudyTracker</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
  <div class="bg-blobs">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
  </div>
  <nav class="navbar px-4 py-3">
    <span class="logo">⚡ StudyTracker</span>
    <a href="/users" class="nav-link-custom">View Sessions →</a>
  </nav>
  <main class="container py-5" style="position:relative;z-index:5;">
    <div class="row justify-content-center">
      <div class="col-12 col-md-6 col-lg-4">
        <div class="glass-card animate-in text-center">
          <div class="success-icon">✓</div>
          <h1 style="font-family:'Syne',sans-serif;font-size:2rem;font-weight:800;">Nice work, <%= name %>!</h1>
          <p style="color:var(--muted);margin-top:0.5rem;">Your study session has been logged.</p>
          <div class="btn-row">
            <a href="/" class="btn-filled">Log Another</a>
            <a href="/users" class="btn-outline">View All</a>
          </div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>