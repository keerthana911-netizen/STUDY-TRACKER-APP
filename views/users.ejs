<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> | StudyTracker</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
  <div class="bg-blobs">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
  </div>
<nav class="navbar px-4 py-3">
  <span class="logo">⚡ StudyTracker</span>

  <div style="display:flex; gap:1rem;">
    <a href="/" class="nav-link-custom">+ New Session</a>
    <a href="/dashboard" class="nav-link-custom">📊 Dashboard</a>
  </div>
</nav>
  <main class="container py-5" style="position:relative;z-index:5;">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-8">
        <div class="table-card animate-in">
          <h1 style="font-family:'Syne',sans-serif;font-size:2rem;font-weight:800;">Study Sessions</h1>
          <p style="color:var(--muted);font-size:0.9rem;margin-bottom:1rem;"><%= users.length %> session(s) logged</p>
          <% if (users.length === 0) { %>
            <div class="empty-state"><p>No sessions yet. <a href="/">Log one!</a></p></div>
          <% } else { %>
            <table class="user-table">
              <thead>
                <tr><th>#</th><th>Name</th><th>Subject</th><th>Hours</th><th>Stress</th></tr>
              </thead>
              <tbody>
                <% users.forEach(function(user) { %>
                  <tr>
                    <td><%= user.id %></td>
                    <td><%= user.studentName %></td>
                    <td><%= user.subject %></td>
                    <td><%= user.hours %>h</td>
                    <td><%= user.stress %>/10</td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          <% } %>
        </div>
      </div>
    </div>
  </main>
</body>
</html>